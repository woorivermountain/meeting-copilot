{
  "name": "meeting-copilot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:service",
    "build:legacy": "nuxt build",
    "dev": "node scripts/dev-service.mjs",
    "dev:legacy": "nuxt dev",
    "build:service": "npm --prefix apps/web run build && mvn -f apps/server/pom.xml verify",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "npm --prefix apps/web run typecheck",
    "typecheck:legacy": "nuxt typecheck",
    "test": "npm --prefix apps/web test && mvn -q -f apps/server/pom.xml test",
    "test:legacy": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/evals.test.ts --reporter=verbose"
  },
  "dependencies": {
    "nuxt": "4.6.0",
    "openai": "7.28.0",
    "postgres": "3.4.9",
    "stripe": "22.5.0",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=22"
  }
}
