# Server-only secrets. Never prefix these with NUXT_PUBLIC_.
NUXT_OPENAI_API_KEY=
NUXT_DATABASE_URL=
NUXT_SESSION_SECRET=replace-with-at-least-32-random-characters
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_STRIPE_TEAM_PRICE_ID=
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Model routing: cheap context worker -> frontier reasoning worker.
NUXT_CONTEXT_MODEL=gpt-5.6-luna
NUXT_REASONING_MODEL=gpt-5.6-sol
NUXT_LLM_MODE=mock
