# Copy to .env.service. Never commit keys or send them in chat.
LLM_ENABLED=true
# Primary provider: deepseek or local. DeepSeek has usage-based API charges.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Use the Groq Free plan; the API key does not reveal or enforce your billing tier.
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional alternative: STT_PROVIDER=azure with an actual Azure F0 resource.
AZURE_SPEECH_TIER=F0
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
# Used only when LLM_PROVIDER=local.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
# Explicit administrator permission to send prompts and retrieved documents externally.
# Enable only after reviewing the selected provider's data policy and sharing scope.
LLM_FALLBACK_ALLOWED=false
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
DEEPGRAM_API_KEY=
